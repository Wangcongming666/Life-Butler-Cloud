<view class="photos"><view class="caption">照片 · {{images.length}} / 6</view><view class="grid"><view wx:for="{{images}}" wx:key="*this" class="slot"><image src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="preview" /><button class="remove" disabled="{{disabled || choosing}}" data-index="{{index}}" catchtap="remove" aria-label="删除第{{index+1}}张照片">×</button></view></view><view class="actions"><button disabled="{{disabled || choosing || images.length >= 6}}" data-source="camera" bindtap="choose">拍照</button><button disabled="{{disabled || choosing || images.length >= 6}}" data-source="album" bindtap="choose">从相册选择</button></view></view>
