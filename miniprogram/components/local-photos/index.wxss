.caption{font-size:25rpx;color:var(--muted,#61776d);margin:24rpx 0 12rpx}.grid{display:flex;flex-wrap:wrap;gap:12rpx}.slot{position:relative;width:calc((100% - 24rpx)/3);height:170rpx}.slot image{width:100%;height:100%;border-radius:16rpx}.remove{position:absolute;right:0;top:0;width:76rpx;height:76rpx;line-height:70rpx;margin:0;padding:0;border-radius:0 16rpx 0 16rpx;background:rgba(30,45,39,.72);color:#fff;font-size:38rpx}.actions{display:flex;gap:16rpx;margin-top:18rpx}.actions button{flex:1;min-height:88rpx;line-height:88rpx;padding:0;font-size:26rpx;border-radius:18rpx;background:var(--soft,#edf3f0);color:var(--accent,#426b5e)}button::after{border:0}
