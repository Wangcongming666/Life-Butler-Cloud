.notes-body { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.capture-bar { display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.capture-bar .primary { flex: 2; }
.capture-bar .secondary { flex: 1; }
.editor { border: 1rpx solid #dce9e2; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.photo-item { position: relative; width: calc((100% - 16rpx) / 2); overflow: hidden; border-radius: 18rpx; background: #edf3f0; }
.draft-image { width: 100%; height: 220rpx; display: block; }
.photo-actions { display: flex; }
.photo-actions button { width: 100%; min-height: 80rpx; line-height: 80rpx; font-size: 24rpx; border-radius: 0; background: transparent; color: #426b5e; padding: 0; }
.photo-toolbar { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.photo-toolbar .clear-photos { margin: 0; min-height: 80rpx; line-height: 80rpx; padding: 0 20rpx; font-size: 24rpx; color: #aa5849; background: #faf2ef; border-radius: 16rpx; }
.photo-toolbar + .photo-grid { margin-top: 12rpx; }
/* 80rpx 点击热区；叉号与预览分开，点击删除不会打开大图。 */
.photo-item .photo-close { position: absolute; z-index: 2; top: 0; right: 0; width: 80rpx; height: 80rpx; min-height: 80rpx; padding: 12rpx; margin: 0; border-radius: 0; background: transparent; display: flex; align-items: center; justify-content: center; }
.close-disc { position: relative; width: 48rpx; height: 48rpx; border-radius: 50%; background: rgba(30,45,39,.78); border: 2rpx solid rgba(255,255,255,.8); }
.close-stroke { position: absolute; top: 21rpx; left: 11rpx; width: 22rpx; height: 3rpx; background: #fff; border-radius: 3rpx; }
.close-stroke-a { transform: rotate(45deg); }
.close-stroke-b { transform: rotate(-45deg); }
.photo-close[disabled] { opacity: .4; }
.photo-pickers { margin-top: 16rpx; }
.comment-input { height: 210rpx; }
.list-heading { margin: 30rpx 0 18rpx; }
.search { margin-bottom: 24rpx; background: #eaf0ed; }
.note-card { border-radius: 28rpx; background: #fff; margin-bottom: 26rpx; overflow: hidden; box-shadow: 0 8rpx 30rpx rgba(39,61,55,.035); }
.note-gallery { padding: 22rpx 22rpx 0; }
.photo-stage { position: relative; height: 380rpx; }
.photo-swiper { position: absolute; z-index: 3; top: 0; right: 0; width: 100%; height: 360rpx; overflow: hidden; border-radius: 20rpx; background: #edf2ef; box-shadow: 0 10rpx 20rpx rgba(30,50,40,.1); }
.has-stack .photo-swiper { width: calc(100% - 38rpx); }
.note-cover { display: block; width: 100%; height: 100%; }
/* 后两张只作叠放预览，不拦截手势，最上层由原生 swiper 处理横向拖动。 */
.stack-back { position: absolute; width: calc(100% - 52rpx); height: 328rpx; border-radius: 20rpx; top: 22rpx; pointer-events: none; }
.stack-back-far { z-index: 1; left: 12rpx; transform: rotate(-5deg); opacity: .5; }
.stack-back-near { z-index: 2; left: 24rpx; transform: rotate(-2.5deg); opacity: .8; box-shadow: 0 6rpx 12rpx rgba(30,50,40,.08); }
.photo-count { position: absolute; z-index: 4; right: 16rpx; bottom: 36rpx; padding: 7rpx 16rpx; background: rgba(29,45,39,.72); color: #fff; border-radius: 12rpx; font-size: 22rpx; pointer-events: none; }
.gallery-controls { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-top: -4rpx; }
.gallery-controls .gallery-arrow { width: 88rpx; height: 80rpx; min-height: 80rpx; line-height: 74rpx; margin: 0; padding: 0; border-radius: 18rpx; background: #edf3f0; color: #426b5e; font-size: 42rpx; }
.gallery-controls .gallery-arrow[disabled] { color: #a8b5ae; background: #f6f8f7; }
.gallery-status { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.gallery-dots { display: flex; gap: 10rpx; height: 10rpx; align-items: center; }
.gallery-dot { width: 8rpx; height: 8rpx; border-radius: 5rpx; background: #cbd8d0; transition: width .18s ease, background-color .18s ease; }
.gallery-dot-active { width: 24rpx; background: #4c7c6d; }
.gallery-hint { color: #61776d; font-size: 21rpx; }
.note-copy { padding: 28rpx; }
.note-heading { align-items: flex-start; }
.note-title { min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.note-price { color: #4c7c6d; font-weight: 600; font-size: 30rpx; flex-shrink: 0; }
.note-comment { display: block; white-space: pre-wrap; word-break: break-all; line-height: 1.7; margin-top: 16rpx; color: #62756d; }
.note-footer { margin-top: 24rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f4f2; }
.note-time { color: #8a9892; font-size: 22rpx; line-height: 1.7; }
.note-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 12rpx; }
.note-actions button { padding: 0 26rpx; min-height: 80rpx; line-height: 80rpx; font-size: 24rpx; background: #edf3f0; color: #426b5e; }
.note-actions .delete-action { background: #faf2ef; color: #aa5849; }
.empty-mark { width: 84rpx; height: 84rpx; line-height: 84rpx; margin: 0 auto 24rpx; border-radius: 24rpx; color: #638778; background: #e8f1ec; font-size: 36rpx; }
.local-tip { text-align: center; font-size: 22rpx; color: #8a9892; padding: 16rpx; }

.note-comment-preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.note-heading .note-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.note-actions { flex-wrap: wrap; }
.note-actions button { padding: 0 20rpx; }
.detail-title { font-size: 34rpx; line-height: 1.5; font-weight: 600; white-space: pre-wrap; word-break: break-all; margin-bottom: 16rpx; }
.detail-photos { margin: 24rpx 0; }
.detail-photo { display: block; width: 100%; border-radius: 18rpx; margin-bottom: 16rpx; }
