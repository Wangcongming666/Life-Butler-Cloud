<view wx:if="{{!cloudReady}}" class="cloud-gate"><view class="title">连接云端记录</view><view class="hint">{{cloudMessage}}</view><button class="primary" loading="{{cloudStatus === 'syncing'}}" disabled="{{cloudStatus === 'syncing'}}" bindtap="syncNow">重试连接</button></view>
<view wx:if="{{cloudReady}}" class="screen {{appearanceClass}}"><view class="header"><view class="title">留一段专注时间</view><view class="subtitle">先做好眼前这一件小事。</view></view><scroll-view class="content" scroll-y="{{!timerFormVisible}}"><view class="body focus-body">
  <view class="card timer-card"><view class="mode-tabs"><button class="{{mode === 'focus' ? 'active' : ''}}" disabled="{{timer}}" data-mode="focus" bindtap="setMode">专注</button><button class="{{mode === 'break' ? 'active' : ''}}" disabled="{{timer}}" data-mode="break" bindtap="setMode">休息</button></view><view class="timer-status">{{timer ? timer.mode === 'focus' ? '专注时间' : '休息时间' : '准备开始'}}{{timer && timer.status === 'paused' ? ' · 已暂停' : ''}}</view><view class="timer-digits">{{display}}</view><view wx:if="{{!timer}}"><view class="actions"><button class="primary" bindtap="openTimerSettings">设置时长并开始 · {{minutes}} 分钟</button></view></view><view wx:else class="actions"><button class="secondary" bindtap="cancel">放弃</button><button wx:if="{{timer.status === 'running'}}" class="primary" bindtap="pause">暂停</button><button wx:else class="primary" bindtap="resume">继续</button></view></view>
  <view class="card row"><view><view class="muted">今日专注</view><view class="section-title">{{todayMinutes}} 分钟</view></view><view><view class="muted">完成次数</view><view class="section-title">{{todayCount}} 次</view></view></view>
  <view class="card"><view class="section-title">最近完成</view><view wx:for="{{history}}" wx:key="id" class="session"><view class="row"><text>{{item.title}}</text><text>{{item.minutes}} 分钟</text></view><view class="muted">{{item.time}}</view></view><view wx:if="{{!history.length}}" class="hint">完成第一段计时后会记录在这里。</view></view>
  <view class="hint">切到后台后按实际时间计算；关闭或切走时不会发送微信通知，返回页面会显示计时结果。</view>
</view></scroll-view><view wx:if="{{timerFormVisible}}" class="info-dialog-mask" catchtouchmove="preventTimerTouch" bindtap="closeTimerSettings"><view class="info-dialog" catchtap="preventTimerTouch" aria-role="dialog" aria-label="设置计时">
<view class="info-dialog-header"><view class="info-dialog-title">{{mode === 'focus' ? '开始专注' : '开始休息'}}</view><button class="info-dialog-close" disabled="{{timerBusy}}" bindtap="closeTimerSettings" aria-label="关闭计时设置">×</button></view>
<scroll-view class="info-dialog-scroll timer-config-scroll" scroll-y><view class="info-dialog-body"><text class="label">时长（分钟）</text><input class="field" disabled="{{timerBusy}}" type="number" maxlength="3" cursor-spacing="120" value="{{minutes}}" bindinput="onMinutes" /><view class="hint">可设置 1～180 分钟，确认后开始计时。</view></view></scroll-view>
<view wx:if="{{timerError}}" class="info-dialog-error">{{timerError}}</view><view class="info-dialog-footer"><view class="actions"><button class="secondary" disabled="{{timerBusy}}" bindtap="closeTimerSettings">取消</button><button class="primary" disabled="{{timerBusy}}" loading="{{timerBusy}}" bindtap="start">开始计时</button></view></view></view></view></view>

<daily-checkin-dialog />
