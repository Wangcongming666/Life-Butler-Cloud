<view wx:if="{{!cloudReady}}" class="cloud-gate"><view class="title">连接云端记录</view><view class="hint">{{cloudMessage}}</view><button class="primary" loading="{{cloudStatus === 'syncing'}}" disabled="{{cloudStatus === 'syncing'}}" bindtap="syncNow">重试连接</button></view>
<view wx:if="{{cloudReady}}" class="screen {{appearanceClass}}"><view class="header"><view class="title">找回你的记录</view><view class="subtitle">待办、账目、随记、课程和生活记录，一起查找。</view></view><scroll-view class="content" scroll-y><view class="body search-body"><input class="field" value="{{query}}" maxlength="80" placeholder="输入名称、备注、课程或存放位置" bindinput="onQuery" confirm-type="search" bindconfirm="search" /><view class="hint">{{searched ? '找到 ' + results.length + ' 条记录' : '输入关键词开始搜索'}}</view><view wx:for="{{results}}" wx:key="key" class="card search-result" data-key="{{item.key}}" bindtap="open" hover-class="pressed" aria-role="button"><view class="row"><view class="section-title">{{item.title}}</view><text class="chip">{{item.kind}}</text></view><view class="result-detail">{{item.detail}}</view><view class="muted">查看记录 ›</view></view><view wx:if="{{searched && !results.length}}" class="card empty">没有找到，换个关键词试试。</view></view></scroll-view></view>

<daily-checkin-dialog />
