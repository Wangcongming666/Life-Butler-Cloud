<view wx:if="{{!cloudReady}}" class="cloud-gate"><view class="title">连接云端记录</view><view class="hint">{{cloudMessage}}</view><button class="primary" loading="{{cloudStatus === 'syncing'}}" disabled="{{cloudStatus === 'syncing'}}" bindtap="syncNow">重试连接</button></view>
<view wx:if="{{cloudReady}}" class="screen {{appearanceClass}}"><view class="header"><view class="title">调成你喜欢的样子。</view><view class="subtitle">显示设置自动保存，返回页面即可生效。</view></view><scroll-view class="content" scroll-y="{{!settingsDialog}}"><view class="body settings-body">
<view class="card"><view class="section-title">显示设置</view><view class="hint">{{settings.theme === 'blue' ? '雾蓝' : settings.theme === 'rose' ? '豆沙粉' : '薄荷绿'}} · {{settings.dark ? '深色模式' : '浅色模式'}} · {{settings.font === 'large' ? '大字号' : '标准字号'}}</view><button class="secondary" data-dialog="appearance" bindtap="openSettingsDialog">调整显示与提醒</button></view>
<view class="card"><view class="section-title">常用功能</view><view class="hint">已选择 {{favorites.length}} 项，可调整工具页入口与顺序。</view><button class="secondary" data-dialog="favorites" bindtap="openSettingsDialog">管理常用功能</button></view><button class="secondary" disabled="{{settingsBusy}}" bindtap="reset">恢复默认设置</button>
</view></scroll-view><view wx:if="{{settingsDialog}}" class="info-dialog-mask" catchtouchmove="preventSettingsTouch" bindtap="closeSettingsDialog"><view class="info-dialog settings-dialog settings-dialog-{{settingsDialog}}" catchtap="preventSettingsTouch" aria-role="dialog" aria-label="{{settingsDialog === 'appearance' ? '显示设置' : '常用功能'}}"><view class="info-dialog-header"><view class="info-dialog-title">{{settingsDialog === 'appearance' ? '显示设置' : '常用功能'}}</view><button class="info-dialog-close" disabled="{{settingsBusy}}" bindtap="closeSettingsDialog" aria-label="关闭设置">×</button></view><scroll-view class="info-dialog-scroll" scroll-y><view class="info-dialog-body"><block wx:if="{{settingsDialog === 'appearance'}}"><view class="card"><view class="section-title">主题色</view><view class="themes"><button disabled="{{settingsBusy}}" wx:for="{{themes}}" wx:key="id" class="theme-choice swatch-{{item.id}} {{settings.theme===item.id?'chosen':''}}" data-id="{{item.id}}" bindtap="theme">{{item.name}}{{settings.theme===item.id?' ✓':''}}</button></view><view class="setting-row"><view><view>深色模式</view><view class="muted">适合夜间查看</view></view><switch disabled="{{settingsBusy}}" checked="{{settings.dark}}" bindchange="onDark" color="#4c7c6d" /></view><view class="setting-row"><view>大字号</view><switch disabled="{{settingsBusy}}" checked="{{settings.font==='large'}}" bindchange="onLarge" color="#4c7c6d" /></view><view class="setting-row"><view><view>首页近期提醒</view><view class="muted">控制待办页和工具页的提醒卡片</view></view><switch disabled="{{settingsBusy}}" checked="{{settings.showReminders}}" bindchange="onReminder" color="#4c7c6d" /></view></view></block><block wx:else>  <view class="card"><view class="section-title">常用功能</view><view class="hint">点击选择常用功能，工具页会优先显示；其余功能仍可使用。</view><view class="entry-grid"><button disabled="{{settingsBusy}}" wx:for="{{entries}}" wx:key="id" class="entry {{item.selected?'entry-selected':''}}" data-id="{{item.id}}" bindtap="favorite">{{item.name}}{{item.selected?' ✓':''}}</button></view></view><view wx:if="{{favorites.length}}" class="card"><view class="section-title">常用功能顺序</view><view wx:for="{{favorites}}" wx:key="id" class="order-row"><text>{{index+1}} · {{item.name}}</text><view class="order-actions"><button class="small-action" disabled="{{settingsBusy || index===0}}" data-id="{{item.id}}" data-step="-1" bindtap="move">上移</button><button class="small-action" disabled="{{settingsBusy || index===favorites.length-1}}" data-id="{{item.id}}" data-step="1" bindtap="move">下移</button></view></view></view></block><view class="hint">修改后自动保存到云端。</view></view></scroll-view><view wx:if="{{settingsError}}" class="info-dialog-error">{{settingsError}}</view><view class="info-dialog-footer"><button class="primary" disabled="{{settingsBusy}}" loading="{{settingsBusy}}" bindtap="closeSettingsDialog">{{settingsBusy ? '正在保存…' : '完成'}}</button></view></view></view></view>
<daily-checkin-dialog />