.settings-body{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.themes{display:flex;gap:12rpx;margin:24rpx 0}.themes .theme-choice{flex:1;padding:0 12rpx;font-size:24rpx;line-height:90rpx}.swatch-mint{background:#e1eee8;color:#315f4b}.swatch-blue{background:#e1edf6;color:#355e7b}.swatch-rose{background:#f3e4e8;color:#855261}.themes .chosen{outline:3rpx solid var(--accent,#4c7c6d);outline-offset:2rpx}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:24rpx 0;border-top:1rpx solid var(--border,#edf2ef);line-height:1.7}.entry-grid{display:flex;flex-wrap:wrap;gap:12rpx}.entry-grid .entry{width:calc((100% - 12rpx)/2);font-size:25rpx;line-height:88rpx;padding:0 8rpx;background:var(--soft,#edf3f0);color:var(--muted,#61776d)}.entry-grid .entry-selected{background:var(--accent,#4c7c6d);color:#fff}.order-row{display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--border,#edf2ef);font-size:26rpx}.order-actions{display:flex}.order-actions button{min-width:88rpx}

.settings-dialog .card { padding: 0; margin-bottom: 24rpx; box-shadow: none; background: transparent; }
.settings-dialog-appearance .info-dialog-scroll { height: 44vh; }
