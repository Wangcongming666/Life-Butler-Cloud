.result { padding: 26rpx; border-radius: 22rpx; margin-top: 28rpx; }
.result-line { display: flex; justify-content: space-between; gap: 16rpx; font-size: 25rpx; line-height: 1.8; margin-bottom: 12rpx; }
.result-line text:last-child { text-align: right; word-break: break-all; }
.unit-result { font-size: 40rpx; line-height: 1.5; font-weight: 600; margin-top: 12rpx; word-break: break-all; }
.back-button { width: fit-content; margin: -16rpx 0 12rpx -12rpx; min-height: 88rpx; line-height: 88rpx; padding: 0 12rpx; background: transparent; color: #426b5e; font-size: 26rpx; text-align: left; }
.tool-search { background: #fff; }
.categories { width: 100%; margin: 16rpx 0 24rpx; white-space: nowrap; }
.category-strip { display: inline-flex; gap: 12rpx; padding: 6rpx 0; }
.category-button { flex-shrink: 0; min-height: 88rpx; padding: 0 24rpx; line-height: 88rpx; background: transparent; color: #5d7168; font-size: 26rpx; }
.category-selected { background: #e1eee8; color: #315e4e; font-weight: 600; }
.tool-list-heading { display: flex; justify-content: space-between; align-items: center; margin: 0 4rpx 22rpx; }
/* 外层四等分，使用 view 点击容器，避开原生 button 默认最小宽度。 */
.tool-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin: -8rpx; }
.tool-slot { flex: 0 0 25%; width: 25%; min-width: 0; padding: 8rpx; box-sizing: border-box; }
.tool-tile { position: relative; display: block; width: 100%; min-width: 0; height: 192rpx; margin: 0; padding: 0; box-sizing: border-box; overflow: hidden; border-radius: 24rpx; background: #e8efeb; text-align: center; line-height: 1.5; box-shadow: 0 6rpx 18rpx rgba(39,61,55,.04); transition: transform .16s ease, opacity .16s ease; }
.tool-background { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; pointer-events: none; }
.tool-tile-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 16rpx 6rpx; box-sizing: border-box; }
.tile-pressed { transform: scale(.95); opacity: .8; }
.tool-icon { flex-shrink: 0; width: 64rpx; height: 64rpx; line-height: 64rpx; border-radius: 20rpx; text-align: center; font-size: 30rpx; font-weight: 600; }
.tone-mint { background: #e1eee8; color: #416f5b; }
.tone-sky { background: #e4edf2; color: #466b80; }
.tone-sand { background: #f3eddf; color: #806b39; }
.tone-rose { background: #f2e5e4; color: #8b5b59; }
.tool-name { width: 100%; margin-top: 18rpx; font-size: 24rpx; font-weight: 600; color: #273d37; white-space: nowrap; text-align: center; }
.tool-footnote { text-align: center; color: #687e73; font-size: 22rpx; line-height: 1.8; margin: 32rpx 0 8rpx; }
.reset-filter { margin-top: 28rpx; }
.result-unit { font-size: 28rpx; font-weight: 400; }
.options-input, .text-input { padding: 24rpx; height: 260rpx; line-height: 1.7; }
.text-input { height: 340rpx; margin-top: 12rpx; }
.text-metrics { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 28rpx; }
.text-metric { width: calc(50% - 10rpx); padding: 16rpx 0; border-bottom: 1rpx solid #e9efeb; }
.metric-value { font-size: 42rpx; font-weight: 600; line-height: 1.5; margin-top: 8rpx; }
.extra-result-value { font-size: 44rpx; font-weight: 600; line-height: 1.5; margin: 14rpx 0 24rpx; word-break: break-all; }
.schedule-entry { display: flex; align-items: center; gap: 20rpx; padding: 26rpx; margin-bottom: 24rpx; border-radius: 26rpx; background: #e1eee8; transition: transform .16s ease; }
.schedule-entry-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 22rpx; background: #fff; color: #426b5e; font-size: 34rpx; line-height: 76rpx; text-align: center; }
.schedule-entry-copy { flex: 1; min-width: 0; }
.schedule-entry-arrow { font-size: 44rpx; color: #426b5e; }
.manager-grid { margin-bottom: 30rpx; }
.local-alert { padding: 20rpx 0; border-bottom: 1rpx solid #edf2ef; line-height: 1.6; }

.tool-dialog .card { padding: 0; margin: 0; background: transparent; box-shadow: none; }
.tool-dialog .info-dialog-scroll { height: 52vh; }

.tool-dialog .info-dialog-body > .card > .section-title:first-child { display: none; }
