.todo-header.header { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; max-width: 840px; align-self: center; padding: 12px 16px 8px; }
.todo-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; min-width: 0; }
.todo-header .todo-page-title { font-size: 24px; line-height: 1.4; }
.todo-count { color: var(--muted); font-size: 12px; line-height: 1.5; }
.todo-header .todo-add-button { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: auto; min-height: 44px; margin: 0; padding: 0 16px; font-size: 14px; line-height: 1.5; border-radius: 12px; }
.body { width: 100%; max-width: 840px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
.todo-controls { margin-bottom: 12px; padding: 0 0 4px; border-bottom: 1px solid var(--border); }
.todo-controls .field { height: 40px; padding: 0 12px; font-size: 14px; border-radius: 10px; }
.todo-inline-notice { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 44px; margin-bottom: 8px; color: var(--muted); font-size: 12px; line-height: 1.5; }
.todo-inline-notice text { min-width: 0; overflow-wrap: anywhere; }
.todo-inline-notice .small-action { flex: 0 0 auto; width: auto; min-height: 44px; margin: 0; padding: 8px 12px; font-size: 13px; line-height: 28px; color: var(--accent); }
.todo-reminders { margin-bottom: 12px; }
.todo-reminders .todo-reminder-summary { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; margin: 0; padding: 4px 0; border-radius: 0; background: transparent; color: var(--muted); text-align: left; font-size: 12px; line-height: 1.5; }
.todo-reminder-summary > text:first-child, .todo-reminder-summary > text:last-child { flex: 0 0 auto; }
.todo-reminder-preview { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.todo-reminder-details { padding: 0 12px; background: var(--soft); border-radius: 12px; }
.todo-reminder-item { display: flex; flex-direction: column; justify-content: center; min-height: 44px; padding: 8px 0; gap: 2px; font-size: 13px; overflow-wrap: anywhere; }
.todo-reminder-item + .todo-reminder-item { border-top: 1px solid var(--border); }
.font-large .todo-page-title { font-size: 28px; }
.font-large .todo-count, .font-large .todo-reminder-summary, .font-large .todo-inline-notice { font-size: 14px; }
.todo-status-tabs { display: flex; gap: 4px; margin-bottom: 8px; }
.todo-status-tabs .status-tab { display: flex; align-items: center; justify-content: center; flex: 1; width: auto; min-height: 44px; margin: 0; padding: 8px; background: transparent; color: var(--muted); font-size: 14px; line-height: 1.5; border-radius: 10px; }
.todo-status-tabs .status-tab-active { background: var(--soft); color: var(--ink); font-weight: 600; }
.todo-status-tabs .status-tab::after { border: none; }
.font-large .todo-status-tabs .status-tab { font-size: 16px; }
.controls .range-confirm { color: var(--accent); }
.range-heading { color: var(--ink); font-size: 16px; font-weight: 600; }
.todo-filter-row, .todo-filter-actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.todo-filter-row { margin-top: 8px; flex-wrap: wrap; }
.range-filter-controls { display: flex; align-items: center; gap: 0; flex-wrap: nowrap; height: 44px; }
.range-filter-controls .range-trigger { flex: 0 0 auto; padding-left: 0; padding-right: 0; font-size: 16px; font-weight: 500; white-space: nowrap; }
.range-filter-controls .range-checkbox { display: flex; align-items: center; justify-content: center; flex: 0 0 44px; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; line-height: 1; }
.range-checkbox-box { display: flex; align-items: center; justify-content: center; width: 18px; height: 18px; border: 1.5px solid #789486; border-radius: 5px; background: transparent; }
.range-checkbox-box .check-mark { width: 5px; height: 9px; }
/* Override native mini-button display so its text centers inside the same 44px row. */
.range-filter-controls .range-trigger { display: flex; align-items: center; justify-content: center; height: 44px; min-height: 44px; margin: 0; padding-top: 0; padding-bottom: 0; line-height: 44px; }
.range-trigger-label { display: block; line-height: 20px; }
.font-large .range-filter-controls .range-trigger { font-size: 18px; }
.todo-filter-actions { margin-left: auto; }
.filter-control { display: flex; align-items: center; justify-content: center; width: auto; min-height: 44px; margin: 0; padding: 0 8px; background: transparent; color: var(--muted); font-size: 13px; line-height: 1.5; border-radius: 8px; }
.filter-control::after { border: none; }
.range-mask { position: fixed; inset: 0; z-index: 2000; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; justify-content: center; }
.range-sheet { width: 100%; max-width: 560px; background: var(--surface); color: var(--ink); border-radius: 20px 20px 0 0; padding-bottom: env(safe-area-inset-bottom); }
.range-sheet-header { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid var(--border); }
.range-sheet-header .range-confirm { color: var(--accent); font-weight: 600; }
.range-sheet-content { max-height: 60vh; padding: 16px; }
.range-endpoint { display: flex; align-items: center; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.range-endpoint-label { color: var(--muted); font-size: 13px; }
.range-value { display: flex; align-items: center; min-height: 44px; padding: 8px 10px; border-radius: 10px; background: var(--soft); color: var(--ink); font-size: 13px; }
.range-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.range-actions .range-action { flex: 1 1 auto; width: auto; min-width: 64px; min-height: 44px; margin: 0; padding: 10px; font-size: 13px; line-height: 24px; }
.range-hint, .range-applied { margin-top: 10px; color: var(--muted); font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
.range-error { margin-top: 10px; color: #a44837; font-size: 13px; line-height: 1.6; }
.theme-dark .range-error { color: #ffbdad; }
.font-large .range-heading { font-size: 16px; }
.font-large .filter-control { font-size: 15px; }
.font-large .range-value, .font-large .range-actions .range-action { font-size: 15px; }
.filter-row { margin-top: 12rpx; }
.filter { min-height: 88rpx; line-height: 88rpx; color: #61776d; font-size: 24rpx; }
.todo-card { padding: 16px 16px 8px; border-radius: 16px; }
.todo-main { display: flex; align-items: flex-start; gap: 8px; width: 100%; min-width: 0; }
/* size=mini + explicit flex basis neutralize native button auto width on both clients. */
.todo-main .check-target { display: flex; align-items: center; justify-content: center; flex: 0 0 44px; width: 44px; min-width: 44px; max-width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; border-radius: 12px; background: transparent; line-height: 1; }
.check { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border: 1.5px solid #789486; border-radius: 7px; background: transparent; transition: background-color 180ms ease-out, border-color 180ms ease-out, transform 180ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms ease-out; }
.check-mark { width: 6px; height: 12px; border-right: 2px solid #fff; border-bottom: 2px solid #fff; opacity: 0; transform: translateY(-2px) rotate(45deg) scale(.45); transition: opacity 160ms ease-out, transform 220ms cubic-bezier(0.16, 1, 0.3, 1); }
.checked { background: var(--accent); border-color: var(--accent); }
.checked .check-mark { opacity: 1; transform: translateY(-2px) rotate(45deg) scale(1); }
.check-target-pressed .check { transform: scale(.9); }
.todo-copy { flex: 1 1 0%; width: 0; min-width: 0; padding-top: 8px; padding-bottom: 8px; }
.todo-title { color: var(--ink); font-size: 16px; line-height: 1.6; word-break: break-all; margin-bottom: 4px; opacity: 1; transition: color 220ms ease-out, opacity 220ms ease-out; }
.todo-card-done .todo-title { color: var(--muted); opacity: .72; text-decoration: line-through; }
.todo-due { font-size: 12px; line-height: 1.65; overflow-wrap: break-word; }
.todo-copy .todo-due.overdue { color: #975c3c; }
.theme-dark .todo-copy .todo-due.overdue { color: #efb98e; }
.todo-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; min-width: 0; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); }
.todo-footer .todo-status { flex: 0 0 auto; padding: 5px 10px; border-radius: 6px; color: var(--muted); font-size: 11px; line-height: 1.5; white-space: nowrap; transition: color 180ms ease-out, background-color 180ms ease-out; }
.todo-card-done .todo-footer .todo-status { color: var(--accent); }
.todo-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; flex: 0 1 auto; align-items: center; gap: 8px; max-width: 100%; margin-left: auto; }
.todo-notification-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 12px; margin-top: 8px; border-top: 1px solid var(--border); }
.todo-notification-copy { min-width: 0; font-size: 13px; line-height: 1.6; }
.todo-notification-copy .muted { font-size: 11px; }
.todo-notification-row switch { flex: 0 0 auto; min-height: 44px; display: flex; align-items: center; }
.todo-actions .todo-action { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: auto; min-width: 60px; min-height: 44px; height: 44px; margin: 0; padding: 0 14px; border-radius: 10px; background: var(--soft); color: var(--accent); font-size: 13px; font-weight: 500; line-height: 1; white-space: nowrap; transition: background-color 180ms ease-out, transform 160ms ease-out, opacity 160ms ease-out; }
.todo-actions .todo-action-delete { background: transparent; color: #a44837; }
.todo-actions .todo-action-pressed { opacity: .7; transform: scale(.96); }
.todo-actions .todo-action[disabled] { opacity: .5; }
.theme-dark .todo-actions .todo-action-delete { color: #ffbdad; }
.font-large .todo-title { font-size: 18px; }
.font-large .todo-due { font-size: 14px; }
.font-large .todo-actions .todo-action { font-size: 15px; }
.attachment-heading { margin-top: 24rpx; margin-bottom: 14rpx; }
.attachment-heading .label { margin: 0; }
.attachment-count { font-size: 23rpx; color: #6c8275; }
.draft-images { display: flex; flex-wrap: wrap; margin: -8rpx; }
.draft-image-slot { flex: 0 0 33.3333%; width: 33.3333%; padding: 8rpx; box-sizing: border-box; }
.draft-image-box { position: relative; height: 172rpx; border-radius: 20rpx; overflow: hidden; background: #edf3ef; }
.draft-image { display: block; width: 100%; height: 100%; }
.image-remove { position: absolute; right: 0; top: 0; display: flex; justify-content: flex-end; align-items: flex-start; width: 72rpx; height: 72rpx; padding: 8rpx; box-sizing: border-box; }
.remove-badge { display: block; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(39,61,55,.75); color: #fff; text-align: center; line-height: 36rpx; font-size: 32rpx; }
.image-picker { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 172rpx; border-radius: 20rpx; background: #edf4ef; color: #527761; font-size: 24rpx; transition: transform .15s ease, opacity .15s ease; }
.image-picker-plus { font-size: 48rpx; line-height: 1.3; margin-bottom: 10rpx; }
.image-picker-busy { opacity: .5; }
.attachment-hint { font-size: 22rpx; color: #6d8175; line-height: 1.6; margin-top: 16rpx; }
@media (prefers-reduced-motion: reduce) {
  .check, .check-mark, .todo-title, .todo-footer .todo-status, .todo-actions .todo-action { transition: none; }
}

.todo-dialog-mask { position: fixed; inset: 0; z-index: 3000; display: flex; align-items: center; justify-content: center; padding: 20px 16px; padding-bottom: max(20px, env(safe-area-inset-bottom)); background: rgba(0, 0, 0, .4); }
.todo-dialog { display: flex; flex-direction: column; width: 100%; max-width: 480px; max-height: 86vh; min-height: 0; overflow: hidden; border-radius: 20px; background: var(--surface); color: var(--ink); }
.todo-dialog-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 12px 12px 4px 20px; }
.todo-dialog .todo-dialog-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; background: transparent; color: var(--muted); font-size: 26px; line-height: 1; }
.todo-dialog-scroll { flex: 1; min-height: 0; height: 52vh; padding: 0 20px; }
.todo-dialog-scroll .label:first-child { margin-top: 8px; }
.todo-dialog .todo-dialog-actions { flex-shrink: 0; margin-top: 0; padding: 16px 20px 20px; border-top: 1px solid var(--border); }
.todo-dialog-actions button { min-width: 0; }
.todo-form-error { margin: 12px 0; color: #a44837; font-size: 13px; line-height: 1.6; }
.theme-dark .todo-form-error { color: #ffbdad; }
.todo-footer .todo-status-late { color: #975c3c; }
.theme-dark .todo-footer .todo-status-late { color: #efb98e; }
.todo-album { position: relative; flex: 0 0 108px; width: 108px; height: 116px; margin: 8px 0 12px 4px; }
.todo-album-back { position: absolute; top: 4px; right: 6px; display: block; width: 94px; height: 104px; border-radius: 12px; background: var(--soft); pointer-events: none; }
.todo-album-back-far { transform: translateX(-3px) rotate(-7deg); opacity: .5; }
.todo-album-back-near { transform: translateX(3px) rotate(6deg); opacity: .75; }
.todo-album-swiper { position: absolute; top: 4px; right: 6px; width: 94px; height: 104px; overflow: hidden; border-radius: 12px; background: var(--soft); }
.todo-album-photo { display: block; width: 100%; height: 100%; }
.todo-album-count { position: absolute; right: 12px; bottom: 12px; padding: 3px 7px; border-radius: 6px; background: rgba(20, 30, 25, .65); color: #fff; font-size: 10px; line-height: 1.4; pointer-events: none; }
.todo-gallery-mask { position: fixed; inset: 0; z-index: 5000; display: flex; align-items: center; justify-content: flex-start; padding: 16px; background: rgba(9, 19, 14, 0); transition: background-color 280ms ease; pointer-events: none; }
.todo-gallery-open { background: rgba(9, 19, 14, .56); pointer-events: auto; }
.todo-gallery-sheet { display: flex; flex-direction: column; width: 62vw; max-width: 240px; height: 76vh; overflow: hidden; border-radius: 18px; background: var(--surface); color: var(--ink); transform: translate3d(calc(-100% - 24px), 0, 0); transition: transform 280ms cubic-bezier(.4, 0, 1, 1); }
.todo-gallery-open .todo-gallery-sheet { transform: translate3d(0, 0, 0); transition-timing-function: cubic-bezier(.16, 1, .3, 1); transition-duration: 400ms; }
.todo-gallery-header { flex-shrink: 0; padding: 14px 10px 12px 14px; border-bottom: 1px solid var(--border); }
.todo-gallery-handle { display: none; }
.todo-gallery-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.todo-gallery-heading { flex: 1; min-width: 0; }
.todo-gallery-title { font-size: 14px; font-weight: 600; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.todo-gallery-heading .muted { margin-top: 4px; }
.todo-gallery-toolbar .todo-gallery-close { flex: 0 0 44px; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; border-radius: 12px; background: var(--soft); color: var(--muted); font-size: 26px; line-height: 1; }
.todo-gallery-image { display: block; width: 100%; height: auto; opacity: 0; transition: opacity 180ms ease-out; }
.todo-gallery-image-loaded { opacity: 1; }
.todo-gallery-loading, .todo-gallery-error { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--muted); font-size: 14px; }
.todo-gallery-error { z-index: 1; }
.todo-gallery-error button { min-height: 44px; margin: 0; padding: 0 18px; font-size: 14px; line-height: 44px; }
.todo-gallery-footer { flex-shrink: 0; padding: 12px; text-align: center; border-top: 1px solid var(--border); }
@media (max-width: 360px) {
  .todo-album { flex-basis: 88px; width: 88px; height: 104px; }
  .todo-album-back, .todo-album-swiper { width: 76px; height: 92px; }
}
@media (prefers-reduced-motion: reduce) {
  .todo-gallery-mask, .todo-gallery-sheet, .todo-gallery-image { transition-duration: 1ms; }
}
.todo-gallery-column { flex: 1; min-height: 0; height: 0; background: var(--page); }
.todo-gallery-list { padding: 12px; }
.todo-gallery-photo-card { position: relative; min-height: 140px; margin-bottom: 12px; overflow: hidden; border-radius: 10px; background: var(--soft); }
.todo-gallery-photo-card:last-child { margin-bottom: 0; }
.todo-gallery-photo-number { position: absolute; right: 6px; bottom: 6px; padding: 3px 6px; border-radius: 5px; background: rgba(20, 30, 25, .65); color: #fff; font-size: 10px; pointer-events: none; }
.todo-gallery-footer .muted { font-size: 11px; }

.todo-image-zoom { position: fixed; inset: 0; z-index: 7000; background: rgba(0,0,0,0); transition: background-color 280ms ease-out; }
.todo-image-zoom-open { background: rgba(0,0,0,.96); }
.todo-image-zoom-photo { position: absolute; display: block; transform-origin: 0 0; border-radius: 10px; transition: transform 280ms cubic-bezier(.4,0,1,1), border-radius 280ms ease; }
.todo-image-zoom-open .todo-image-zoom-photo { border-radius: 0; transition-duration: 360ms; transition-timing-function: cubic-bezier(.16,1,.3,1); }
.todo-image-zoom-toolbar { position: absolute; top: calc(12px + env(safe-area-inset-top)); left: 20px; right: 16px; display: flex; align-items: center; justify-content: space-between; color: #fff; font-size: 14px; opacity: 0; transition: opacity 160ms ease-out; }
.todo-image-zoom-open .todo-image-zoom-toolbar { opacity: 1; }
.todo-image-zoom-toolbar .todo-image-zoom-close { display: flex; align-items: center; justify-content: center; width: 44px; min-height: 44px; height: 44px; margin: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; font-size: 28px; line-height: 1; }
.todo-image-zoom-error { position: absolute; left: 20px; right: 20px; bottom: 36px; color: #fff; text-align: center; font-size: 14px; }
@media (prefers-reduced-motion: reduce) { .todo-image-zoom, .todo-image-zoom-photo, .todo-image-zoom-toolbar { transition-duration: 1ms; } }
