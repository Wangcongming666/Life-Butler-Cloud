<view wx:if="{{!cloudReady}}" class="cloud-gate"><view class="title">连接云端记录</view><view class="hint">{{cloudMessage}}</view><button class="primary" loading="{{cloudStatus === 'syncing'}}" disabled="{{cloudStatus === 'syncing'}}" bindtap="syncNow">重试连接</button></view>
<view wx:if="{{cloudReady}}" class="screen {{appearanceClass}}"><view class="header"><view class="title">今天，好好吃饭。</view><view class="subtitle">收藏自己的拿手菜，安排一周三餐。</view></view><scroll-view class="content" scroll-y="{{!formVisible && !detailVisible && !mealVisible}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation><view class="body food-body">
  <view class="tabs"><button class="{{section==='recipes'?'active':''}}" data-section="recipes" bindtap="switchSection">我的菜谱</button><button class="{{section==='plan'?'active':''}}" data-section="plan" bindtap="switchSection">每周饮食</button></view>
  <block wx:if="{{section==='recipes'}}"><button class="primary" disabled="{{busy}}" bindtap="add">＋ 收藏一道菜</button>
    <input class="field recipe-search" value="{{query}}" maxlength="80" placeholder="搜索菜名、分类或食材" bindinput="onQuery" />
    <view wx:for="{{recipes}}" wx:key="id" class="card recipe-summary"><image wx:if="{{item.images.length}}" class="recipe-thumbnail" src="{{item.images[0]}}" mode="aspectFill" data-id="{{item.id}}" bindtap="showDetail" /><view class="row"><view class="section-title">{{item.title}}</view><text class="chip">{{item.category}} · {{item.servings}}份</text></view><view class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="showDetail">查看详情</button><button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="danger" disabled="{{busy}}" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view wx:if="{{!recipes.length}}" class="card empty">把第一道拿手菜记在这里。</view>
  </block>
  <block wx:else><view class="week-controls"><button class="secondary" data-step="-1" bindtap="shiftWeek">‹ 上周</button><picker mode="date" value="{{weekDate}}" bindchange="onWeek"><view class="week-picker">选择日期 ▾</view></picker><button class="secondary" data-step="1" bindtap="shiftWeek">下周 ›</button></view><view class="hint">{{weekRange}}</view>
    <view wx:for="{{days}}" wx:key="date" class="card"><view class="row"><view class="section-title">{{item.label}}</view><text class="muted">{{item.date}}</text></view><view wx:for="{{item.slots}}" wx:key="slot" wx:for-item="mealItem" class="meal-row"><view class="meal-copy" data-date="{{item.date}}" data-slot="{{mealItem.slot}}" bindtap="openMeal"><view><text class="meal-slot">{{mealItem.name}}</text>{{mealItem.title}}</view></view><button wx:if="{{mealItem.id}}" class="small-action delete-action" data-id="{{mealItem.id}}" bindtap="removeMeal">移除</button></view></view>
  </block>
</view></scroll-view>
  <view wx:if="{{formVisible}}" class="info-dialog-mask" catchtouchmove="stopTouch"><view class="info-dialog" aria-role="dialog" aria-modal="true" aria-label="{{draft.id?'编辑菜谱':'新建菜谱'}}">
    <view class="info-dialog-header"><view class="info-dialog-title">{{draft.id?'编辑菜谱':'新建菜谱'}}</view><button class="info-dialog-close" disabled="{{busy}}" bindtap="close" aria-label="关闭弹窗">×</button></view>
    <scroll-view class="info-dialog-scroll" scroll-y><view class="info-dialog-body" id="recipe-editor"><text class="label">菜名</text><input cursor-spacing="120" class="field" disabled="{{busy}}" value="{{draft.title}}" maxlength="80" data-key="title" bindinput="onField" /><text class="label">分类</text><input cursor-spacing="120" class="field" disabled="{{busy}}" value="{{draft.category}}" maxlength="20" data-key="category" bindinput="onField" /><text class="label">份数（1～30）</text><input cursor-spacing="120" class="field" disabled="{{busy}}" type="number" value="{{draft.servings}}" maxlength="2" data-key="servings" bindinput="onField" /><text class="label">食材与用量，每行一种</text><textarea cursor-spacing="120" class="field ingredients" disabled="{{busy}}" value="{{draft.ingredientsText}}" maxlength="9000" placeholder="鸡蛋 2个&#10;番茄 1个" data-key="ingredientsText" bindinput="onField" /><text class="label">做法步骤</text><textarea cursor-spacing="120" class="field steps-input" disabled="{{busy}}" value="{{draft.steps}}" maxlength="5000" placeholder="按步骤写下做法" data-key="steps" bindinput="onField" /><text class="label">备注</text><textarea cursor-spacing="120" class="field textarea" disabled="{{busy}}" value="{{draft.note}}" maxlength="2000" data-key="note" bindinput="onField" /><local-photos images="{{draft.images}}" disabled="{{busy}}" bindchange="onPhotos" bindbusy="onBusy" /></view></scroll-view>
    <view class="info-dialog-footer"><view wx:if="{{formError}}" class="info-dialog-error">{{formError}}</view><view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="close">取消</button><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="save">保存菜谱</button></view></view>
  </view></view>

  <view wx:if="{{mealVisible}}" class="info-dialog-mask" catchtouchmove="stopTouch"><view class="info-dialog" aria-role="dialog" aria-modal="true" aria-label="安排一餐">
    <view class="info-dialog-header"><view class="info-dialog-title">安排一餐</view><button class="info-dialog-close" disabled="{{busy}}" bindtap="closeMeal" aria-label="关闭弹窗">×</button></view>
    <scroll-view class="info-dialog-scroll" scroll-y><view class="info-dialog-body" id="meal-editor"><text class="label">日期</text><picker disabled="{{busy}}" mode="date" value="{{meal.date}}" data-key="date" bindchange="onMeal"><view class="field picker-field">{{meal.date}} ▾</view></picker><text class="label">餐次</text><picker disabled="{{busy}}" range="{{slots}}" value="{{slotIndex}}" bindchange="onSlot"><view class="field picker-field">{{slots[slotIndex]}} ▾</view></picker><text class="label">选择菜谱</text><picker disabled="{{busy}}" range="{{recipeNames}}" value="{{recipeIndex}}" bindchange="onRecipe"><view class="field picker-field">{{recipeNames[recipeIndex]}} ▾</view></picker><block wx:if="{{recipeIndex===0}}"><text class="label">餐食名称</text><input cursor-spacing="120" disabled="{{busy}}" class="field" value="{{meal.title}}" maxlength="80" data-key="title" bindinput="onMeal" /></block><text class="label">备注</text><input cursor-spacing="120" disabled="{{busy}}" class="field" value="{{meal.note}}" maxlength="500" data-key="note" bindinput="onMeal" /><view class="hint">同一天同一餐次只保留一份安排，保存会替换原安排；可在餐食名称中写多道菜。</view></view></scroll-view>
    <view class="info-dialog-footer"><view wx:if="{{mealError}}" class="info-dialog-error">{{mealError}}</view><view class="actions"><button disabled="{{busy}}" class="secondary" bindtap="closeMeal">取消</button><button disabled="{{busy}}" class="primary" loading="{{busy}}" bindtap="saveMeal">保存安排</button></view></view>
  </view></view>

  <view wx:if="{{detailVisible}}" class="info-dialog-mask" catchtouchmove="stopTouch"><view class="info-dialog" aria-role="dialog" aria-modal="true" aria-label="菜谱详情">
    <view class="info-dialog-header"><view class="info-dialog-title">菜谱详情</view><button class="info-dialog-close" disabled="{{busy}}" bindtap="closeDetail" aria-label="关闭弹窗">×</button></view>
    <scroll-view class="info-dialog-scroll" scroll-y><view class="info-dialog-body" ><view class="section-title">{{detail.title}}</view><view class="hint">{{detail.category}} · {{detail.servings}}份</view><image wx:if="{{detail.images.length}}" class="recipe-cover" src="{{detail.images[0]}}" mode="aspectFill" data-id="{{detail.id}}" bindtap="preview" /><view class="label">食材</view><view wx:for="{{detail.ingredients}}" wx:key="name" class="ingredient"><text>{{item.name}}</text><text>{{item.quantity}}</text></view><view class="label">做法</view><text class="recipe-text" selectable>{{detail.steps}}</text><text wx:if="{{detail.note}}" class="recipe-note" selectable>{{detail.note}}</text></view></scroll-view>
    <view class="info-dialog-footer"><view class="actions"><button class="secondary" disabled="{{busy}}" data-id="{{detail.id}}" bindtap="shopping">食材加入购物</button><button class="primary" disabled="{{busy}}" data-recipe="{{detail.id}}" bindtap="openMeal">安排一餐</button></view><view class="actions"><button class="secondary" bindtap="closeDetail">关闭</button><button class="secondary" disabled="{{busy}}" data-id="{{detail.id}}" bindtap="edit">编辑菜谱</button></view></view>
  </view></view>
</view>

<daily-checkin-dialog />
