.food-body{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.tabs{display:flex;gap:12rpx;margin-bottom:24rpx}.tabs button{flex:1;background:var(--soft,#edf3f0);color:var(--muted,#61776d);line-height:88rpx}.tabs .active{background:var(--accent,#4c7c6d);color:#fff}.editor{margin-top:24rpx}.ingredients,.steps-input{height:240rpx;padding:22rpx;line-height:1.7}.recipe-search{margin:24rpx 0}.recipe-cover{width:100%;height:300rpx;border-radius:18rpx;margin-bottom:24rpx}.recipe-text,.recipe-note{white-space:pre-wrap;word-break:break-all;display:block;line-height:1.8}.recipe-note{margin-top:20rpx;color:var(--muted,#61776d)}.ingredient{display:flex;justify-content:space-between;padding:10rpx 0;gap:16rpx}.week-controls{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.week-controls button{font-size:24rpx;padding:0 20rpx}.week-picker{padding:20rpx;color:var(--accent,#4c7c6d)}.meal-row{display:flex;gap:12rpx;align-items:center;border-bottom:1rpx solid var(--border,#edf2ef)}.meal-copy{flex:1;min-width:0;padding:24rpx 0;line-height:1.7;word-break:break-all}.meal-slot{color:var(--muted,#61776d);margin-right:20rpx}.section-title{word-break:break-all;min-width:0}

.info-dialog .actions{display:flex;gap:12rpx;margin-top:16rpx}.info-dialog .actions button{flex:1;min-width:0}.info-dialog-body .label:first-child{margin-top:0}
 .recipe-thumbnail{width:112rpx;height:112rpx;border-radius:14rpx;float:left;margin-right:20rpx}.recipe-summary .actions{clear:both;padding-top:16rpx}
