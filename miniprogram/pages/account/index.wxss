.account-summary { background: #dfece6; padding: 32rpx; }
.summary-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; }
.month-picker { display: flex; align-items: center; min-height: 44px; padding: 0 16rpx; border-radius: 12rpx; background: var(--surface); color: var(--ink); font-size: 24rpx; }
.billing-statistics { padding: 28rpx; }
.billing-category { display: flex; justify-content: space-between; align-items: baseline; gap: 24rpx; padding-top: 20rpx; font-size: 26rpx; }
.billing-category-amount { text-align: right; overflow-wrap: anywhere; }
.billing-pagination { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 24rpx 0 40rpx; color: var(--muted); font-size: 24rpx; }
.billing-pagination .load-more { margin: 0; width: auto; max-width: 100%; min-height: 44px; padding: 8px 16px; white-space: normal; line-height: 1.6; }
.theme-dark .summary-caption, .theme-dark .summary-bottom, .theme-dark .summary-total { color: var(--ink); }
.theme-dark .summary-bottom { border-color: var(--border); }
.summary-month { font-size: 27rpx; color: #426959; }
.summary-badge { font-size: 21rpx; color: #4c735f; padding: 8rpx 14rpx; border-radius: 12rpx; background: #eef6f0; }
.summary-caption { margin-top: 32rpx; font-size: 25rpx; color: #426959; }
.summary-total { font-size: 64rpx; font-weight: 600; line-height: 1.3; margin-top: 12rpx; color: #284d3c; word-break: break-all; }
.currency { font-size: 36rpx; font-weight: 400; }
.summary-bottom { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid #ccded2; font-size: 23rpx; color: #486e59; }
.amount-input { font-size: 40rpx; height: 104rpx; }
.list-heading { margin: 36rpx 4rpx 12rpx; }
.day-divider { margin: 24rpx 4rpx 16rpx; color: #637b6c; font-size: 24rpx; }
.expense-card { padding: 28rpx 26rpx 16rpx; margin-bottom: 18rpx; }
.expense-selected { background: #f6fbf7; }
.expense-main { display: flex; align-items: flex-start; gap: 18rpx; }
.category-icon { flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 22rpx; line-height: 72rpx; text-align: center; font-size: 29rpx; font-weight: 600; }
.category-mint { background: #e7f1e9; color: #4b745b; }
.category-blue { background: #e6eef5; color: #52708a; }
.category-rose { background: #f5e8e9; color: #94686d; }
.category-sand { background: #f3eddf; color: #8a7549; }
.category-gray { background: #edf0ee; color: #65776a; }
.expense-copy { flex: 1; min-width: 0; padding-top: 2rpx; }
.expense-category { font-size: 29rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.expense-note { font-size: 24rpx; line-height: 1.6; color: #65786c; margin-top: 6rpx; word-break: break-all; }
.expense-amount { flex-shrink: 0; max-width: 52%; padding-top: 2rpx; font-size: 34rpx; font-weight: 600; line-height: 1.5; color: #2c493b; text-align: right; word-break: break-all; }
.amount-currency { font-size: 24rpx; margin-left: 4rpx; }
.expense-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 22rpx; padding-top: 14rpx; border-top: 1rpx solid #eff3f0; }
.expense-timestamps { flex: 1; min-width: 0; }
.expense-time, .expense-updated { display: block; font-size: 21rpx; color: #718477; line-height: 1.7; overflow-wrap: break-word; }
.expense-updated { margin-top: 4rpx; color: #708174; }
.expense-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.expense-actions .record-action { display: block; width: 88rpx; min-width: 0; min-height: 88rpx; line-height: 88rpx; padding: 0; margin: 0; font-size: 24rpx; border-radius: 16rpx; }
.record-edit { background: #edf4ee; color: #406d53; }
.record-delete { background: transparent; color: #a17066; }

.account-header-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.account-header-row .account-add-button { flex: 0 0 auto; width: auto; min-height: 44px; margin: 0; padding: 0 16px; font-size: 14px; line-height: 44px; white-space: nowrap; }
.account-dialog-mask { position: fixed; inset: 0; z-index: 3000; display: flex; align-items: center; justify-content: center; padding: 20px 16px; padding-bottom: max(20px, env(safe-area-inset-bottom)); background: rgba(0, 0, 0, .4); }
.account-dialog { display: flex; flex-direction: column; width: 100%; max-width: 480px; max-height: 86vh; min-height: 0; overflow: hidden; border-radius: 20px; background: var(--surface); color: var(--ink); }
.account-dialog-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 12px 12px 4px 20px; }
.account-dialog .account-dialog-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; background: transparent; color: var(--muted); font-size: 26px; line-height: 1; }
.account-dialog-scroll { flex: 1; min-height: 0; height: 48vh; padding: 0 20px 16px; }
.account-dialog-scroll .label:first-child { margin-top: 8px; }
.account-dialog .account-dialog-actions { flex-shrink: 0; margin-top: 0; padding: 16px 20px 20px; border-top: 1px solid var(--border); }
.account-dialog-actions button { min-width: 0; }
.account-top-actions { display: flex; gap: 12px; margin-top: 16px; }
.account-top-actions button { flex: 1; width: auto; min-width: 0; min-height: 44px; margin: 0; padding: 8px 12px; font-size: 14px; line-height: 28px; }
