.month-caption { margin-top: 28rpx; font-size: 25rpx; }
.month-amount { margin: 10rpx 0; font-size: 52rpx; line-height: 1.25; font-weight: 600; overflow-wrap: anywhere; }
.overview-totals { font-size: 23rpx; line-height: 1.7; overflow-wrap: anywhere; }
.todo-overview { border-top: 1rpx solid var(--border); margin-top: 28rpx; padding-top: 26rpx; }
.progress { margin: 20rpx 0; }
.todo-counts { display: flex; text-align: center; }
.todo-counts > view { flex: 1; min-width: 0; }
.todo-counts .stat-number { margin: 0 0 6rpx; font-size: 34rpx; }
.todo-counts .muted { font-size: 24rpx; }
.personal-grid, .data-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.personal-grid button, .data-grid button { flex: 0 0 calc(50% - 8rpx); width: calc(50% - 8rpx); min-width: 0; min-height: 44px; margin: 0; padding: 22rpx 8rpx; line-height: 1.5; }
.entry-caption { margin-top: 8rpx; font-size: 23rpx; font-weight: 400; color: var(--muted); }
.sync-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 20rpx; }
.sync-description { flex: 1 1 260rpx; min-width: 0; }
.sync-status { margin-top: 12rpx; line-height: 1.6; overflow-wrap: anywhere; }
.sync-time { margin-top: 6rpx; font-size: 23rpx; }
.sync-button { flex: 0 0 auto; margin: 0; padding: 16rpx 24rpx; line-height: 1.5; }
.sync-hint { margin-bottom: 0; }
.font-large .todo-counts .muted, .font-large .entry-caption, .font-large .overview-totals, .font-large .sync-time { font-size: 28rpx; }
.json-text { display: block; padding: 24rpx; font-family: monospace; font-size: 22rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.footer { text-align: center; color: #94a29b; font-size: 22rpx; margin: 32rpx 0; }

.info-dialog .json-text{margin-top:24rpx;border-radius:16rpx;background:var(--soft,#f3f6f5)}.info-dialog-footer .actions{display:flex;gap:12rpx;margin-top:0}.info-dialog-footer .actions button{flex:1;min-width:0}
