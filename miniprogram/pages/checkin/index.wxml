<view wx:if="{{!cloudReady}}" class="cloud-gate"><view class="title">连接签到记录</view><view class="hint">{{cloudMessage}}</view><button class="primary" loading="{{cloudStatus === 'syncing'}}" disabled="{{cloudStatus === 'syncing'}}" bindtap="syncNow">重试连接</button></view>
<view wx:if="{{cloudReady}}" class="screen {{appearanceClass}}">
  <view class="header"><view class="title">每日签到</view><view class="subtitle">每天来看看，留下生活的足迹。</view></view>
  <scroll-view class="content" scroll-y><view class="body checkin-body">
    <view class="card tinted checkin-hero"><view class="row"><text class="checkin-status">{{stats.signedToday ? '今日已签到' : '今天还未签到'}}</text><text class="muted">{{today}}</text></view><view class="checkin-caption">连续签到</view><view class="checkin-streak">{{stats.streak}}<text> 天</text></view><button class="primary" bindtap="signIn" loading="{{busy}}" disabled="{{busy || stats.signedToday}}">{{stats.signedToday ? '今天的足迹已留下' : '立即签到'}}</button></view>
    <view class="checkin-totals"><view class="card"><view class="muted">累计签到</view><view class="checkin-total">{{stats.total}}<text> 天</text></view></view><view class="card"><view class="muted">最长连续</view><view class="checkin-total">{{stats.longest}}<text> 天</text></view></view></view>
    <view class="card checkin-calendar"><view class="checkin-month-row"><button class="checkin-month-button" data-delta="-1" bindtap="changeMonth" disabled="{{month==='1970-01'}}" aria-label="上个月">‹</button><picker mode="date" fields="month" start="1970-01" end="{{today}}" value="{{month}}" bindchange="onMonth"><view class="checkin-month-label">{{monthLabel}} ▾</view></picker><button class="checkin-month-button" data-delta="1" bindtap="changeMonth" disabled="{{!canNext}}" aria-label="下个月">›</button></view><view class="checkin-calendar-grid"><view wx:for="{{weekdays}}" wx:key="*this" class="checkin-weekday">{{item}}</view><view wx:for="{{days}}" wx:key="key" class="checkin-day {{item.checked ? 'checkin-day-signed' : ''}} {{item.today ? 'checkin-day-today' : ''}} {{item.future ? 'checkin-day-future' : ''}}"><text>{{item.blank ? '' : item.label}}</text><text wx:if="{{item.checked}}" class="checkin-day-mark">✓</text></view></view><view class="checkin-calendar-footer"><text>✓ 已签到</text><text>本月 {{monthCount}} 天</text></view></view>
    <view class="card checkin-quote"><view class="checkin-quote-text">{{stats.quote.text}}</view><view class="muted checkin-quote-source">{{stats.quote.source}}</view></view>
    <view class="muted checkin-help">每天首次进入自动签到，同一天只记一次。漏签后连续天数重新计算，历史记录会保留。</view>
  </view></scroll-view>
</view>
<daily-checkin-dialog />
