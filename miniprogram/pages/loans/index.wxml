<view wx:if="{{!cloudReady}}" class="cloud-gate"><view class="title">连接云端记录</view><view class="hint">{{cloudMessage}}</view><button class="primary" loading="{{cloudStatus === 'syncing'}}" disabled="{{cloudStatus === 'syncing'}}" bindtap="syncNow">重试连接</button></view>
<view wx:if="{{cloudReady}}" class="screen {{appearanceClass}}"><view class="header"><view class="title">借与还，都有着落。</view><view class="subtitle">记下物品、对方和约定的日子。</view></view><scroll-view class="content" scroll-y="{{!formVisible && !detailVisible}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation><view class="body personal-body">
  <button class="primary" disabled="{{busy}}" bindtap="add">＋ 新增借还记录</button>
  <view class="search-row"><input class="field" value="{{query}}" maxlength="80" placeholder="搜索物品或姓名" bindinput="onQuery" /><picker range="{{filters}}" value="{{filter}}" bindchange="onFilter"><view class="filter">{{filters[filter]}} ▾</view></picker></view>
  <view wx:for="{{records}}" wx:key="id" class="card"><view class="row"><view class="section-title">{{item.title}}</view><text class="chip">{{item.directionText}} · {{item.status}}</text></view><view class="detail">{{item.direction==='out'?'借给':'向对方借入'}} {{item.person}}</view><view class="detail">借用 {{item.borrowDate}}{{item.dueDate?' · 约定归还 '+item.dueDate:''}}</view><view wx:if="{{item.returnedText}}" class="detail">归还于 {{item.returnedText}}</view><view class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="showDetail">详情</button><button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="toggle">{{item.returnedAt===null?'标记归还':'恢复未归还'}}</button><button class="secondary" disabled="{{busy}}" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="danger" disabled="{{busy}}" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view wx:if="{{!records.length}}" class="card empty">暂无对应借还记录</view>
</view></scroll-view>
  <view wx:if="{{formVisible}}" class="info-dialog-mask" catchtouchmove="stopTouch"><view class="info-dialog" aria-role="dialog" aria-modal="true" aria-label="{{draft.id?'编辑':'新建'}}记录">
    <view class="info-dialog-header"><view class="info-dialog-title">{{draft.id?'编辑':'新建'}}记录</view><button class="info-dialog-close" disabled="{{busy}}" bindtap="close" aria-label="关闭弹窗">×</button></view>
    <scroll-view class="info-dialog-scroll" scroll-y><view class="info-dialog-body" id="loan-editor"><text class="label">物品名称</text><input cursor-spacing="120" class="field" disabled="{{busy}}" maxlength="80" value="{{draft.title}}" data-key="title" bindinput="onField" /><text class="label">借用方向</text><picker disabled="{{busy}}" range="{{directions}}" value="{{directionIndex}}" bindchange="onDirection"><view class="field picker-field">{{directions[directionIndex]}} ▾</view></picker><text class="label">对方姓名</text><input cursor-spacing="120" class="field" disabled="{{busy}}" maxlength="80" value="{{draft.person}}" data-key="person" bindinput="onField" /><text class="label">借用日期</text><picker disabled="{{busy}}" mode="date" value="{{draft.borrowDate}}" data-key="borrowDate" bindchange="onField"><view class="field picker-field">{{draft.borrowDate}} ▾</view></picker><text class="label">约定归还日期（选填）</text><picker disabled="{{busy}}" mode="date" value="{{draft.dueDate}}" data-key="dueDate" bindchange="onField"><view class="field picker-field">{{draft.dueDate||'选择日期'}} ▾</view></picker><button wx:if="{{draft.dueDate}}" class="small-action" bindtap="clearDue">清除归还日期</button><text class="label">备注</text><textarea cursor-spacing="120" class="field textarea" disabled="{{busy}}" maxlength="2000" value="{{draft.note}}" data-key="note" bindinput="onField" /><local-photos images="{{draft.images}}" disabled="{{busy}}" bindchange="onPhotos" bindbusy="onBusy" /></view></scroll-view>
    <view class="info-dialog-footer"><view wx:if="{{formError}}" class="info-dialog-error">{{formError}}</view><view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="close">取消</button><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="save">保存</button></view></view>
  </view></view>

  <view wx:if="{{detailVisible}}" class="info-dialog-mask" catchtouchmove="stopTouch"><view class="info-dialog" aria-role="dialog" aria-modal="true" aria-label="借还详情">
    <view class="info-dialog-header"><view class="info-dialog-title">借还详情</view><button class="info-dialog-close" disabled="{{busy}}" bindtap="closeDetail" aria-label="关闭弹窗">×</button></view>
    <scroll-view class="info-dialog-scroll" scroll-y><view class="info-dialog-body" ><view class="section-title">{{detail.title}}</view><view class="detail">{{detail.directionText}} · {{detail.status}} · {{detail.person}}</view><view class="detail">借用 {{detail.borrowDate}}</view><view wx:if="{{detail.dueDate}}" class="detail">约定归还 {{detail.dueDate}}</view><view wx:if="{{detail.returnedText}}" class="detail">归还于 {{detail.returnedText}}</view><text wx:if="{{detail.note}}" class="record-note" selectable>{{detail.note}}</text><image wx:if="{{detail.images.length}}" class="cover" src="{{detail.images[0]}}" mode="aspectFill" data-id="{{detail.id}}" bindtap="preview" /></view></scroll-view>
    <view class="info-dialog-footer"><view class="actions"><button class="secondary" bindtap="closeDetail">关闭</button><button class="primary" disabled="{{busy}}" data-id="{{detail.id}}" bindtap="edit">编辑记录</button></view></view>
  </view></view>
</view>

<daily-checkin-dialog />
