.personal-body{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.editor{margin-top:24rpx}.search-row{display:flex;gap:12rpx;align-items:center;margin:24rpx 0}.search-row input{flex:1;min-width:0}.filter{padding:20rpx 12rpx;min-width:140rpx;color:var(--accent,#426b5e)}.detail{font-size:25rpx;line-height:1.7;color:var(--muted,#61776d);margin-top:14rpx}.record-note{display:block;white-space:pre-wrap;word-break:break-all;line-height:1.7;margin-top:18rpx}.cover{width:100%;height:260rpx;border-radius:18rpx;margin-top:22rpx}.actions{flex-wrap:wrap}.actions button{min-width:130rpx;padding:0 14rpx;font-size:25rpx}.section-title{word-break:break-all;min-width:0}

.info-dialog .actions{display:flex;gap:12rpx;margin-top:16rpx}.info-dialog .actions button{flex:1;min-width:0}.info-dialog-body .label:first-child{margin-top:0}
