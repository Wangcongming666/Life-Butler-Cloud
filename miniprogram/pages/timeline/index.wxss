.timeline-body{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.tabs{display:flex;gap:12rpx;margin-bottom:24rpx}.tabs button{flex:1;line-height:88rpx;background:var(--soft,#edf3f0);color:var(--muted,#61776d)}.tabs .active{background:var(--accent,#4c7c6d);color:#fff}.search{margin:20rpx 0}.kind-strip{display:inline-flex;gap:10rpx}.kinds{white-space:nowrap}.kind-strip button{flex-shrink:0;padding:0 22rpx;line-height:80rpx;min-height:80rpx;font-size:24rpx;background:var(--soft,#edf3f0);color:var(--muted,#61776d)}.kind-strip .selected{background:var(--accent,#4c7c6d);color:#fff}.event{position:relative;display:flex;gap:24rpx;padding-left:2rpx}.event::before{content:'';position:absolute;left:11rpx;top:16rpx;bottom:-4rpx;width:2rpx;background:var(--border,#dbe6df)}.event-dot{position:relative;width:20rpx;height:20rpx;flex-shrink:0;background:var(--accent,#4c7c6d);border-radius:50%;margin-top:10rpx}.event-content{flex:1;min-width:0}.event .card{margin-top:14rpx;padding:24rpx}.event-detail{display:block;white-space:pre-wrap;word-break:break-all;line-height:1.7;margin-top:16rpx}.event-cover{width:100%;height:260rpx;border-radius:16rpx;margin-top:18rpx}.event .section-title{word-break:break-all}

.event-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.event-photo-count { margin-top: 12rpx; }
.event-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; }
.event-actions .small-action { margin: 0; min-height: 44px; display: flex; align-items: center; }
.event-photos .event-cover { background: var(--soft); }
