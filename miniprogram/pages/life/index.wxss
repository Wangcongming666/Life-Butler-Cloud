.life-body { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.top-actions { margin-bottom: 24rpx; }
.top-actions .primary { min-width: 180rpx; }
.filter-bar { display: flex; gap: 14rpx; margin: 20rpx 0 26rpx; }
.filter-bar .filter { flex: 1; line-height: 80rpx; min-height: 80rpx; font-size: 25rpx; background: #eaf0ed; color: #526e61; padding: 0; }
.filter-bar .selected { color: #fff; background: #4c7c6d; }
.record-title { flex: 1; min-width: 0; word-break: break-all; }
.record .row { align-items: flex-start; }
.detail { margin-top: 14rpx; font-size: 25rpx; color: #60776a; line-height: 1.6; word-break: break-all; }
.record-note { display: block; margin-top: 18rpx; white-space: pre-wrap; line-height: 1.7; word-break: break-all; }
.record-done { opacity: .7; }
.record-footer { margin-top: 24rpx; padding-top: 14rpx; border-top: 1rpx solid #edf2ef; }
.record-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; }
.record-actions .small-action { min-width: 96rpx; }
.urgent, .warning { color: #a65b42; background: #fbf1e8; }
.attachment-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.attachment { width: calc((100% - 32rpx) / 3); position: relative; height: 160rpx; }
.attachment image { width: 100%; height: 100%; border-radius: 16rpx; }
.attachment .image-remove { position: absolute; top: 0; right: 0; width: 76rpx; min-height: 76rpx; line-height: 70rpx; padding: 0; color: #fff; background: rgba(30,45,39,.7); border-radius: 0 16rpx 0 16rpx; font-size: 38rpx; }
.record-images { margin-top: 22rpx; white-space: nowrap; }
.image-strip { display: flex; gap: 12rpx; }
.image-strip image { flex-shrink: 0; width: 160rpx; height: 160rpx; border-radius: 16rpx; }
.budget-card { margin-top: 24rpx; }
.budget-card progress { margin-top: 24rpx; }
.category-row { padding: 24rpx 0; display: flex; justify-content: space-between; border-bottom: 1rpx solid #edf2ef; gap: 18rpx; }
.calendar-grid { display: flex; flex-wrap: wrap; }
.weekday { width: calc(100% / 7); text-align: center; color: #7a8b84; line-height: 70rpx; }
.calendar-grid .calendar-day { width: calc(100% / 7); height: 78rpx; line-height: 78rpx; padding: 0; border-radius: 12rpx; background: #f6f8f7; color: #3a5748; font-size: 25rpx; }
.calendar-grid .checked { color: #fff; background: #4c7c6d; }
.calendar-grid .today { font-weight: 700; text-decoration: underline; }
.calendar-grid .calendar-day[disabled] { opacity: .35; }

.budget-toolbar { display: flex; align-items: center; gap: 12px; }
.budget-toolbar picker { flex: 1; min-width: 0; }
.budget-toolbar .budget-edit-button { flex: 0 0 auto; width: auto; min-height: 44px; margin: 0; padding: 0 16px; font-size: 14px; line-height: 44px; }
.budget-dialog-mask { position: fixed; inset: 0; z-index: 3000; display: flex; align-items: center; justify-content: center; padding: 20px 16px; padding-bottom: max(20px, env(safe-area-inset-bottom)); background: rgba(0, 0, 0, .4); }
.budget-dialog { display: flex; flex-direction: column; width: 100%; max-width: 480px; max-height: 86vh; min-height: 0; overflow: hidden; border-radius: 20px; background: var(--surface); color: var(--ink); }
.budget-dialog-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 16px 12px 4px 20px; }
.budget-dialog-header .muted { margin-top: 4px; }
.budget-dialog .budget-dialog-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; background: transparent; color: var(--muted); font-size: 26px; line-height: 1; }
.budget-dialog-scroll { flex: 1; min-height: 0; height: 40vh; padding: 0 20px 16px; }
.budget-dialog .budget-category-input { height: 140px; }
.budget-dialog .budget-delete-button { width: auto; min-height: 44px; margin: 12px 0 0; padding: 0 4px; background: transparent; color: #a44837; text-align: left; font-size: 14px; line-height: 44px; }
.theme-dark .budget-dialog .budget-delete-button { color: #ffbdad; }
.budget-dialog .budget-dialog-actions { flex-shrink: 0; margin-top: 0; padding: 16px 20px 20px; border-top: 1px solid var(--border); }
.budget-dialog-actions button { min-width: 0; }
.budget-allocation-hint { margin-top: 12px; }
/* 作业卡片：内容纵向阅读，主要操作与次要操作在同一行。 */
.homework-card { padding: 28rpx; }
.homework-card .record-header { gap: 20rpx; align-items: flex-start; }
.homework-card .record-title { font-size: 32rpx; line-height: 1.5; }
.homework-card .chip { flex-shrink: 0; margin-top: 4rpx; }
.homework-meta { margin-top: 24rpx; }
.homework-meta-row { display: flex; align-items: flex-start; gap: 16rpx; margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; }
.homework-meta-label { flex-shrink: 0; width: 72rpx; color: var(--muted); }
.homework-meta-value { flex: 1; min-width: 0; color: var(--ink); word-break: break-all; }
.homework-deadline { font-weight: 600; }
.homework-card .record-note { margin-top: 24rpx; font-size: 27rpx; }
.homework-footer { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.homework-updated { display: block; font-size: 22rpx; line-height: 1.5; color: var(--muted); }
.homework-actions { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.homework-actions button { width: auto; min-width: 0; min-height: 88rpx; line-height: 88rpx; margin: 0; padding: 0 16rpx; font-size: 26rpx; border-radius: 18rpx; }
.homework-actions .homework-complete { flex: 1; background: var(--accent); color: #fff; }
.homework-actions .homework-complete.is-complete { background: var(--soft); color: var(--ink); }
.homework-actions .homework-tool { flex: 0 0 96rpx; width: 96rpx; padding: 0; background: var(--soft); color: var(--ink); }
.homework-actions .homework-delete { background: transparent; color: #a44837; }
.theme-dark .homework-actions .homework-delete { color: #ffbdad; }
.homework-card.record-done { opacity: 1; }.homework-card.record-done .record-title { color: var(--muted); }
.font-large .homework-card .record-title { font-size: 36rpx; }.font-large .homework-meta-row, .font-large .homework-actions button { font-size: 30rpx; }.font-large .homework-updated { font-size: 25rpx; }

.record-note-preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.record-detail-link { margin-top: 12rpx; padding: 14rpx 0; color: var(--accent); font-size: 25rpx; min-height: 44px; box-sizing: border-box; display: flex; align-items: center; }
.detail-attachments { margin-top: 24rpx; }
.detail-attachments image { width: calc((100% - 32rpx) / 3); height: 160rpx; border-radius: 16rpx; }
.info-dialog .calendar-grid { margin-top: 16rpx; }
